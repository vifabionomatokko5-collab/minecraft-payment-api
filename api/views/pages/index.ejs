<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Miragem Store - Loja Minecraft</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:system-ui,sans-serif; }
        body { background:#1a1a2e; color:#fff; min-height:100vh; }
        header { background:#16213e; padding:20px; text-align:center; border-bottom:2px solid #ff6b00; }
        header h1 { font-size:2.5rem; color:#ff6b00; }
        header h1 span { color:#fff; }
        header p { color:#aaa; margin-top:5px; }
        main { max-width:1200px; margin:40px auto; padding:0 20px; }
        .products-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:25px; margin-top:30px; }
        .product-card { background:#16213e; border-radius:12px; padding:25px; text-align:center; border:1px solid #ff6b00; transition:0.3s; }
        .product-card:hover { transform:translateY(-5px); border-color:#ff8c00; box-shadow:0 10px 30px rgba(255,107,0,0.2); }
        .product-card h3 { font-size:1.3rem; margin-bottom:10px; }
        .product-card .price { font-size:1.8rem; color:#ff6b00; font-weight:bold; margin:15px 0; }
        .btn-buy { display:inline-block; background:#ff6b00; color:#fff; padding:12px 35px; border:none; border-radius:8px; font-weight:bold; font-size:1rem; cursor:pointer; text-decoration:none; transition:0.2s; }
        .btn-buy:hover { background:#ff8c00; }
        footer { text-align:center; padding:30px; color:#666; margin-top:40px; border-top:1px solid #ff6b00; }
        .empty { text-align:center; color:#666; margin-top:40px; font-size:1.2rem; }
        @media(max-width:600px){ header h1 { font-size:1.8rem; } .products-grid { grid-template-columns:1fr; } }
    </style>
</head>
<body>
    <header>
        <h1>🏪 <span>Miragem</span> Store</h1>
        <p>Compre itens para o servidor <strong>Miragem SMP</strong> de forma rápida e segura!</p>
    </header>

    <main>
        <section>
            <h2>🛒 Produtos Disponíveis</h2>
            
            <% if (products && products.length > 0) { %>
                <div class="products-grid">
                    <% products.forEach(product => { %>
                        <div class="product-card">
                            <h3><%= product.name %></h3>
                            <p class="price">R$ <%= product.price.toFixed(2) %></p>
                            <a href="/comprar/<%= product.id %>" class="btn-buy">Comprar</a>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty">⚠️ Nenhum produto disponível no momento. Volte em breve!</p>
            <% } %>
        </section>
    </main>

    <footer>
        <p>© 2026 <strong>Miragem Store</strong> - Todos os direitos reservados</p>
        <p style="font-size:0.8rem; color:#444; margin-top:5px;">Powered by MinePay</p>
    </footer>
</body>
</html>
