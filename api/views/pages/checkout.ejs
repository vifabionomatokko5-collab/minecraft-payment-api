<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Miragem Store</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .coupon-container {
            display: flex;
            gap: 10px;
            margin: 15px 0;
        }
        .coupon-container input {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #0f3460;
            background: #1a1a2e;
            color: #fff;
            font-size: 1rem;
            text-transform: uppercase;
        }
        .coupon-container input:focus {
            outline: none;
            border-color: #ff6b00;
        }
        .coupon-container button {
            background: #0f3460;
            color: #fff;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .coupon-container button:hover {
            background: #1a4a7a;
        }
        .coupon-applied {
            background: #00ff88;
            color: #1a1a2e;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
            font-weight: bold;
        }
        .coupon-error {
            background: #ff4444;
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
        }
        .discount-info {
            color: #00ff88;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <h1>🛒 <span>Checkout</span></h1>
        <a href="/" class="btn-back" style="color:#ff6b00;text-decoration:none;">← Voltar</a>
    </header>

    <main>
        <div class="checkout-container">
            <h2 style="text-align:center;color:#ff6b00;">Resumo do Pedido</h2>
            
            <div id="order-summary" style="margin:20px 0;padding:15px;background:#1a1a2e;border-radius:8px;">
                <p style="color:#666;text-align:center;">Carregando...</p>
            </div>

            <!-- ========== CUPOM ========== -->
            <div style="margin:15px 0;">
                <label style="color:#aaa;">🎫 Cupom de desconto</label>
                <div class="coupon-container">
                    <input type="text" id="coupon-input" placeholder="Digite o código do cupom" maxlength="20">
                    <button onclick="applyCoupon()">Aplicar</button>
                </div>
                <div id="coupon-message"></div>
            </div>

            <div style="text-align:center;font-size:1.5rem;color:#ff6b00;font-weight:bold;margin:15px 0;">
                Total: <span id="total-amount">R$ 0.00</span>
                <div id="discount-display" style="font-size:0.9rem;color:#00ff88;"></div>
            </div>

            <form id="payment-form">
                <div class="form-group">
                    <label for="username">🎮 Seu nickname no Minecraft</label>
                    <input type="text" id="username" placeholder="Ex: F4RINHA777" required>
                </div>
                <button type="submit" class="btn-pay">💰 Gerar PIX</button>
            </form>

            <div id="payment-result" style="display:none;">
                <h3>📲 Escaneie o QR Code</h3>
                <img id="qr-code" src="" alt="QR Code PIX">
                <p>Ou copie o código abaixo:</p>
                <textarea id="pix-code" readonly></textarea>
                <button onclick="copiarPix()" class="btn-copy">📋 Copiar Código</button>
                <div id="payment-status" class="pending">⏳ Aguardando pagamento...</div>
            </div>
        </div>
    </main>

    <footer>
        <p>© 2026 Miragem Store - Todos os direitos reservados</p>
    </footer>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const itemsParam = urlParams.get('items');
        let items = [];
        let total = 0;
        let loadedItems = 0;
        let appliedCoupon = null;
        let discountAmount = 0;
        let finalTotal = 0;

        // ========== APLICAR CUPOM ==========
        async function applyCoupon() {
            const input = document.getElementById('coupon-input');
            const code = input.value.trim().toUpperCase();
            const messageDiv = document.getElementById('coupon-message');
            
            if (!code) {
                messageDiv.innerHTML = '<div class="coupon-error">Digite um código de cupom!</div>';
                return;
            }

            try {
                const response = await fetch('/api/coupons/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, amount: total })
                });

                const data = await response.json();

                if (data.valid) {
                    appliedCoupon = data;
                    discountAmount = data.discount_amount;
                    finalTotal = data.final_amount;
                    
                    messageDiv.innerHTML = `
                        <div class="coupon-applied">
                            ✅ Cupom ${data.code} aplicado! 
                            Desconto: ${data.discount_type === 'percentage' ? `${data.discount_value}%` : `R$ ${data.discount_amount.toFixed(2)}`}
                            <br>Total com desconto: R$ ${data.final_amount.toFixed(2)}
                        </div>
                    `;
                    
                    document.getElementById('discount-display').innerHTML = `
                        <span class="discount-info">
                            🎫 Cupom: ${data.code} - Desconto de R$ ${data.discount_amount.toFixed(2)}
                        </span>
                    `;
                    
                    updateTotalDisplay();
                } else {
                    messageDiv.innerHTML = `<div class="coupon-error">❌ ${data.error || 'Cupom inválido!'}</div>`;
                    appliedCoupon = null;
                    discountAmount = 0;
                    finalTotal = total;
                    document.getElementById('discount-display').innerHTML = '';
                    updateTotalDisplay();
                }
            } catch (error) {
                console.error('Erro ao validar cupom:', error);
                messageDiv.innerHTML = '<div class="coupon-error">❌ Erro ao validar cupom. Tente novamente.</div>';
            }
        }

        // ========== RENDERIZAR RESUMO ==========
        function renderSummary() {
            const container = document.getElementById('order-summary');
            total = 0;
            
            if (items.length === 0) {
                container.innerHTML = '<p style="color:#666;text-align:center;">Carrinho vazio</p>';
                document.getElementById('total-amount').textContent = 'R$ 0.00';
                return;
            }
            
            container.innerHTML = items.map(item => {
                total += item.price * item.qty;
                return `
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #0f3460;">
                        <span>${item.name} x${item.qty}</span>
                        <span style="color:#ff6b00;">R$ ${(item.price * item.qty).toFixed(2)}</span>
                    </div>
                `;
            }).join('');

            finalTotal = total;
            updateTotalDisplay();
        }

        function updateTotalDisplay() {
            const display = document.getElementById('total-amount');
            if (appliedCoupon) {
                display.textContent = `R$ ${finalTotal.toFixed(2)}`;
                display.style.color = '#00ff88';
            } else {
                display.textContent = `R$ ${total.toFixed(2)}`;
                display.style.color = '#ff6b00';
            }
        }

        // ========== CARREGAR PRODUTOS ==========
        if (itemsParam) {
            const pairs = itemsParam.split(',');
            const totalItems = pairs.length;
            
            pairs.forEach((pair, index) => {
                const [id, qty] = pair.split(':');
                fetch(`/api/products/${id}`)
                    .then(res => {
                        if (!res.ok) {
                            throw new Error('Produto não encontrado');
                        }
                        return res.json();
                    })
                    .then(product => {
                        items.push({ ...product, qty: parseInt(qty) });
                        loadedItems++;
                        if (loadedItems === totalItems) {
                            renderSummary();
                        }
                    })
                    .catch(error => {
                        console.error('Erro ao carregar produto:', error);
                        loadedItems++;
                        if (loadedItems === totalItems) {
                            renderSummary();
                        }
                    });
            });
        } else {
            renderSummary();
        }

        // ========== ENVIAR PAGAMENTO ==========
        document.getElementById('payment-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const username = document.getElementById('username').value.trim();
            
            if (!username) {
                alert('Digite seu nickname!');
                return;
            }

            if (items.length === 0) {
                alert('Seu carrinho está vazio!');
                return;
            }

            const btn = document.querySelector('.btn-pay');
            btn.textContent = '🔄 Gerando...';
            btn.disabled = true;

            try {
                // Criar pagamento para cada item com o cupom
                const paymentPromises = [];
                for (const item of items) {
                    for (let i = 0; i < item.qty; i++) {
                        let productId = item.id;
                        let couponCode = appliedCoupon ? appliedCoupon.code : null;
                        
                        // Se tem cupom, só aplica no primeiro item
                        if (couponCode && i > 0) {
                            couponCode = null;
                        }
                        
                        const promise = fetch('/api/payment/create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                userId: 'web_' + Date.now(),
                                username: username,
                                productId: productId,
                                couponCode: couponCode
                            })
                        }).then(res => res.json());
                        paymentPromises.push(promise);
                    }
                }

                const responses = await Promise.all(paymentPromises);
                
                const failed = responses.find(r => !r.success);
                if (failed) {
                    alert('❌ Erro ao criar pagamento: ' + (failed.error || 'Tente novamente'));
                    btn.textContent = '💰 Gerar PIX';
                    btn.disabled = false;
                    return;
                }

                const first = responses[0];
                document.getElementById('payment-result').style.display = 'block';
                document.getElementById('qr-code').src = first.qrCode;
                document.getElementById('pix-code').value = first.qrCode;
                document.getElementById('payment-status').textContent = '⏳ Aguardando pagamento...';
                document.getElementById('payment-status').className = 'pending';

                let attempts = 0;
                const maxAttempts = 120;

                const interval = setInterval(async () => {
                    attempts++;
                    
                    try {
                        const statusPromises = responses.map(r => 
                            fetch(`/api/payment/${r.paymentId}`).then(res => res.json())
                        );
                        const statuses = await Promise.all(statusPromises);
                        
                        const allDelivered = statuses.every(s => s.status === 'delivered');
                        
                        if (allDelivered) {
                            document.getElementById('payment-status').textContent = '✅ Todos os itens entregues!';
                            document.getElementById('payment-status').className = 'delivered';
                            clearInterval(interval);
                            document.getElementById('payment-form').style.display = 'none';
                        } else if (attempts >= maxAttempts) {
                            document.getElementById('payment-status').textContent = '⏰ Tempo esgotado. Se pagou, aguarde.';
                            document.getElementById('payment-status').className = 'error';
                            clearInterval(interval);
                        } else {
                            const deliveredCount = statuses.filter(s => s.status === 'delivered').length;
                            document.getElementById('payment-status').textContent = 
                                `⏳ Aguardando pagamento... (${deliveredCount}/${responses.length} entregues)`;
                        }
                    } catch (error) {
                        console.error('Erro ao verificar status:', error);
                    }
                }, 5000);

            } catch (error) {
                console.error('Erro:', error);
                alert('❌ Erro ao processar seu pedido.');
            } finally {
                btn.textContent = '💰 Gerar PIX';
                btn.disabled = false;
            }
        });

        // ========== COPIAR PIX ==========
        async function copiarPix() {
            const pix = document.getElementById('pix-code').value;
            try {
                await navigator.clipboard.writeText(pix);
                const btn = document.querySelector('.btn-copy');
                btn.textContent = '✅ Copiado!';
                setTimeout(() => btn.textContent = '📋 Copiar Código', 3000);
            } catch {
                alert('Selecione o código e copie manualmente.');
            }
        }
    </script>
</body>
</html>
