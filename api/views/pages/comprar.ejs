<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprar - Miragem Store</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:system-ui,sans-serif; }
        body { background:#1a1a2e; color:#fff; min-height:100vh; }
        header { background:#16213e; padding:20px; text-align:center; border-bottom:2px solid #ff6b00; }
        header h1 { font-size:2rem; color:#ff6b00; }
        .btn-back { display:inline-block; color:#ff6b00; text-decoration:none; margin:10px 0; }
        .btn-back:hover { text-decoration:underline; }
        main { max-width:500px; margin:40px auto; padding:0 20px; }
        .payment-container { background:#16213e; border-radius:12px; padding:30px; border:1px solid #ff6b00; }
        .product-info { text-align:center; margin-bottom:20px; }
        .product-info h2 { font-size:1.5rem; }
        .product-info .price { font-size:2rem; color:#ff6b00; font-weight:bold; }
        .product-info .description { color:#aaa; margin:10px 0; font-size:0.95rem; }
        .product-info .includes-box { background:#1a1a2e; border-radius:8px; padding:15px; margin:15px 0; text-align:left; border:1px solid #0f3460; }
        .product-info .includes-box p { color:#ff6b00; font-weight:bold; margin-bottom:8px; }
        .product-info .includes-box pre { color:#aaa; font-family:monospace; font-size:0.85rem; white-space:pre-wrap; word-break:break-word; margin:0; }

        /* ========== CUPOM ========== */
        .coupon-container {
            display: flex;
            gap: 10px;
            margin: 15px 0;
        }
        .coupon-container input {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #0f3460;
            background: #1a1a2e;
            color: #fff;
            font-size: 1rem;
            text-transform: uppercase;
        }
        .coupon-container input:focus {
            outline: none;
            border-color: #ff6b00;
        }
        .coupon-container button {
            background: #0f3460;
            color: #fff;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .coupon-container button:hover {
            background: #1a4a7a;
        }
        .coupon-applied {
            background: #00ff88;
            color: #1a1a2e;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
            font-weight: bold;
        }
        .coupon-error {
            background: #ff4444;
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
        }
        .discount-info {
            color: #00ff88;
            font-size: 0.9rem;
        }

        .form-group { margin:20px 0; }
        .form-group label { display:block; margin-bottom:8px; color:#aaa; }
        .form-group input { width:100%; padding:12px; border-radius:8px; border:1px solid #ff6b00; background:#1a1a2e; color:#fff; font-size:1rem; }
        .form-group input:focus { outline:none; border-color:#ff8c00; }
        .btn-pay { width:100%; background:#ff6b00; color:#fff; padding:14px; border:none; border-radius:8px; font-weight:bold; font-size:1.1rem; cursor:pointer; transition:0.2s; }
        .btn-pay:hover { background:#ff8c00; }
        #payment-result { margin-top:30px; padding-top:20px; border-top:1px solid #ff6b00; text-align:center; }
        #payment-result h3 { color:#ff6b00; margin-bottom:15px; }
        #qr-code { width:200px; height:200px; margin:10px auto; display:block; background:#fff; padding:10px; border-radius:8px; }
        #pix-code { width:100%; padding:12px; border-radius:8px; background:#1a1a2e; color:#fff; border:1px solid #ff6b00; margin:10px 0; resize:vertical; font-size:0.8rem; word-break:break-all; }
        .btn-copy { background:#ff6b00; color:#fff; padding:10px 25px; border:none; border-radius:8px; font-size:1rem; cursor:pointer; transition:0.2s; }
        .btn-copy:hover { background:#ff8c00; }
        #payment-status { margin-top:15px; font-size:1.1rem; padding:10px; border-radius:8px; }
        #payment-status.pending { color:#ffaa00; background:#2a1a00; }
        #payment-status.delivered { color:#00ff88; background:#001a0a; }
        #payment-status.error { color:#ff4444; background:#1a0000; }
        footer { text-align:center; padding:30px; color:#666; margin-top:40px; border-top:1px solid #ff6b00; }
        @media(max-width:600px){ .payment-container { padding:20px; } }
    </style>
</head>
<body>
    <header>
        <h1>🛒 Miragem Store</h1>
        <a href="/" class="btn-back">← Voltar para a loja</a>
    </header>

    <main>
        <div class="payment-container">
            <div class="product-info">
                <h2><%= product.name %></h2>
                <p class="price">R$ <%= product.price.toFixed(2) %></p>
                <% if (product.description) { %>
                    <p class="description"><%= product.description %></p>
                <% } %>
                <% if (product.includes) { %>
                    <div class="includes-box">
                        <p>📦 Vem com:</p>
                        <pre><%= product.includes %></pre>
                    </div>
                <% } %>
            </div>

            <!-- ========== CUPOM ========== -->
            <div style="margin:15px 0;">
                <label style="color:#aaa;">🎫 Cupom de desconto</label>
                <div class="coupon-container">
                    <input type="text" id="coupon-input" placeholder="Digite o código do cupom" maxlength="20">
                    <button onclick="applyCoupon()">Aplicar</button>
                </div>
                <div id="coupon-message"></div>
            </div>

            <div style="text-align:center;font-size:1rem;color:#ff6b00;font-weight:bold;margin:10px 0;">
                Total: <span id="total-amount">R$ <%= product.price.toFixed(2) %></span>
                <div id="discount-display" style="font-size:0.9rem;color:#00ff88;"></div>
            </div>

            <form id="payment-form">
                <div class="form-group">
                    <label for="username">🎮 Seu nickname no Minecraft</label>
                    <input type="text" id="username" placeholder="Ex: F4RINHA777" required>
                </div>
                <button type="submit" class="btn-pay">💰 Gerar PIX</button>
            </form>

            <div id="payment-result" style="display:none;">
                <h3>📲 Escaneie o QR Code</h3>
                <img id="qr-code" src="" alt="QR Code PIX">
                <p style="margin:15px 0 5px;">Ou copie o código abaixo:</p>
                <textarea id="pix-code" readonly></textarea>
                <button onclick="copiarPix()" class="btn-copy">📋 Copiar Código</button>
                <div id="payment-status" class="pending">⏳ Aguardando pagamento...</div>
            </div>
        </div>
    </main>

    <footer>
        <p>© 2026 <strong>Miragem Store</strong> - Todos os direitos reservados</p>
        <p style="font-size:0.8rem; color:#444; margin-top:5px;">Powered by MinePay</p>
    </footer>

    <script>
        const productPrice = <%= product.price %>;
        let appliedCoupon = null;
        let discountAmount = 0;
        let finalTotal = productPrice;

        // ========== APLICAR CUPOM ==========
        async function applyCoupon() {
            const input = document.getElementById('coupon-input');
            const code = input.value.trim().toUpperCase();
            const messageDiv = document.getElementById('coupon-message');
            
            if (!code) {
                messageDiv.innerHTML = '<div class="coupon-error">Digite um código de cupom!</div>';
                return;
            }

            try {
                const response = await fetch('/api/coupons/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, amount: productPrice })
                });

                const data = await response.json();

                if (data.valid) {
                    appliedCoupon = data;
                    discountAmount = data.discount_amount;
                    finalTotal = data.final_amount;
                    
                    messageDiv.innerHTML = `
                        <div class="coupon-applied">
                            ✅ Cupom ${data.code} aplicado! 
                            Desconto: ${data.discount_type === 'percentage' ? `${data.discount_value}%` : `R$ ${data.discount_amount.toFixed(2)}`}
                            <br>Total com desconto: R$ ${data.final_amount.toFixed(2)}
                        </div>
                    `;
                    
                    document.getElementById('discount-display').innerHTML = `
                        <span class="discount-info">
                            🎫 Cupom: ${data.code} - Desconto de R$ ${data.discount_amount.toFixed(2)}
                        </span>
                    `;
                    
                    updateTotalDisplay();
                } else {
                    messageDiv.innerHTML = `<div class="coupon-error">❌ ${data.error || 'Cupom inválido!'}</div>`;
                    appliedCoupon = null;
                    discountAmount = 0;
                    finalTotal = productPrice;
                    document.getElementById('discount-display').innerHTML = '';
                    updateTotalDisplay();
                }
            } catch (error) {
                console.error('Erro ao validar cupom:', error);
                messageDiv.innerHTML = '<div class="coupon-error">❌ Erro ao validar cupom. Tente novamente.</div>';
            }
        }

        function updateTotalDisplay() {
            const display = document.getElementById('total-amount');
            if (appliedCoupon) {
                display.textContent = `R$ ${finalTotal.toFixed(2)}`;
                display.style.color = '#00ff88';
            } else {
                display.textContent = `R$ ${productPrice.toFixed(2)}`;
                display.style.color = '#ff6b00';
            }
        }

        // ========== ENVIAR PAGAMENTO ==========
        document.getElementById('payment-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = document.getElementById('username').value.trim();
            const productId = '<%= product.id %>';
            const couponCode = appliedCoupon ? appliedCoupon.code : null;
            
            if (!username) { alert('Digite seu nickname!'); return; }
            
            const btn = document.querySelector('.btn-pay');
            btn.textContent = '🔄 Gerando...';
            btn.disabled = true;
            
            try {
                const response = await fetch('/api/payment/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        userId: 'web_' + Date.now(), 
                        username, 
                        productId,
                        couponCode: couponCode
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    document.getElementById('payment-result').style.display = 'block';
                    document.getElementById('qr-code').src = data.qrCode;
                    document.getElementById('pix-code').value = data.qrCode;
                    document.getElementById('payment-status').textContent = '⏳ Aguardando pagamento...';
                    document.getElementById('payment-status').className = 'pending';
                    
                    let attempts = 0;
                    const interval = setInterval(async () => {
                        attempts++;
                        try {
                            const statusResponse = await fetch('/api/payment/' + data.paymentId);
                            const statusData = await statusResponse.json();
                            if (statusData.status === 'delivered') {
                                document.getElementById('payment-status').textContent = '✅ Pagamento confirmado! Item entregue!';
                                document.getElementById('payment-status').className = 'delivered';
                                clearInterval(interval);
                                document.getElementById('payment-form').style.display = 'none';
                            } else if (attempts >= 120) {
                                document.getElementById('payment-status').textContent = '⏰ Tempo esgotado. Se pagou, aguarde.';
                                document.getElementById('payment-status').className = 'error';
                                clearInterval(interval);
                            }
                        } catch (error) { console.error(error); }
                    }, 5000);
                } else {
                    alert('❌ Erro: ' + (data.error || 'Tente novamente'));
                }
            } catch (error) {
                alert('❌ Erro ao processar seu pedido.');
            } finally {
                btn.textContent = '💰 Gerar PIX';
                btn.disabled = false;
            }
        });
        
        async function copiarPix() {
            const pix = document.getElementById('pix-code').value;
            try {
                await navigator.clipboard.writeText(pix);
                const btn = document.querySelector('.btn-copy');
                btn.textContent = '✅ Copiado!';
                setTimeout(() => btn.textContent = '📋 Copiar Código', 3000);
            } catch { alert('Selecione o código e copie manualmente.'); }
        }
    </script>
</body>
</html>
